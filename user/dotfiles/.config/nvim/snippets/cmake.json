{
  "CMake Min Version & Project": {
    "prefix": "cinit",
    "body": [
      "cmake_minimum_required(VERSION ${1:3.15})",
      "project(${2:MyProject} VERSION 1.0 LANGUAGES CXX)",
      "",
      "set(CMAKE_CXX_STANDARD ${3:17})",
      "set(CMAKE_CXX_STANDARD_REQUIRED ON)",
      "",
      "set(CMAKE_EXPORT_COMPILE_COMMANDS ON)",
      "",
      "# Only try to use mold on Linux/macOS",
      "if(NOT WIN32)",
      "    # Look for mold in system PATH or Nix environment",
      "    find_program(MOLD_PATH mold)",
      "    ",
      "    if(MOLD_PATH)",
      "        message(STATUS \"Found mold linker: \\${MOLD_PATH}\")",
      "        # Tell the compiler to use the mold linker",
      "        add_link_options(\"-fuse-ld=mold\")",
      "    else()",
      "        message(STATUS \"mold linker not found, using system default linker\")",
      "    endif()",
      "endif()",
      "",
      "find_program(CCACHE_PROGRAM ccache)",
      "",
      "if(CCACHE_PROGRAM)",
      "    message(STATUS \"Found ccache: \\${CCACHE_PROGRAM}\")",
      "    # Set C++ and C compiler launchers to ccache",
      "    set(CMAKE_CXX_COMPILER_LAUNCHER \\${CCACHE_PROGRAM})",
      "    set(CMAKE_C_COMPILER_LAUNCHER \\${CCACHE_PROGRAM})",
      "else()",
      "    message(STATUS \"ccache not found, compilation cache disabled\")",
      "endif()",
      "",
      "add_executable(\\${PROJECT_NAME} ${4:main.cpp})"
    ],
    "description": "Initialize a standard CMake project"
  },
  "CMake Min Version & Project (CUDA)": {
    "prefix": "cinitcuda",
    "body": [
      "cmake_minimum_required(VERSION ${1:3.15})",
      "project(${2:MyProject} VERSION 1.0 LANGUAGES CXX CUDA)",
      "",
      "set(CMAKE_CXX_STANDARD ${3:17})",
      "set(CMAKE_CXX_STANDARD_REQUIRED ON)",
      "set(CMAKE_CUDA_STANDARD ${3:17})",
      "set(CMAKE_CUDA_STANDARD_REQUIRED ON)",
      "",
      "if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)",
      "    set(CMAKE_CUDA_ARCHITECTURES native)",
      "endif()",
      "",
      "set(CMAKE_EXPORT_COMPILE_COMMANDS ON)",
      "",
      "# Only try to use mold on Linux/macOS",
      "if(NOT WIN32)",
      "    # Look for mold in system PATH or Nix environment",
      "    find_program(MOLD_PATH mold)",
      "    ",
      "    if(MOLD_PATH)",
      "        message(STATUS \"Found mold linker: \\${MOLD_PATH}\")",
      "        # Tell the compiler to use the mold linker",
      "        add_link_options(\"-fuse-ld=mold\")",
      "    else()",
      "        message(STATUS \"mold linker not found, using system default linker\")",
      "    endif()",
      "endif()",
      "",
      "find_program(CCACHE_PROGRAM ccache)",
      "",
      "if(CCACHE_PROGRAM)",
      "    message(STATUS \"Found ccache: \\${CCACHE_PROGRAM}\")",
      "    # Set C++ C Cuda compiler launchers to ccache",
      "    set(CMAKE_CXX_COMPILER_LAUNCHER \\${CCACHE_PROGRAM})",
      "    set(CMAKE_C_COMPILER_LAUNCHER \\${CCACHE_PROGRAM})",
      "    set(CMAKE_CUDA_COMPILER_LAUNCHER \\${CCACHE_PROGRAM})",
      "else()",
      "    message(STATUS \"ccache not found, compilation cache disabled\")",
      "endif()",
      "",
      "add_executable(\\${PROJECT_NAME} ${4:main.cu})"
    ],
    "description": "Initialize a standard CMake CUDA project"
  },
  "Mold Linker": {
    "prefix": "cmold",
    "body": [
      "# Only try to use mold on Linux/macOS",
      "if(NOT WIN32)",
      "    # Look for mold in system PATH or Nix environment",
      "    find_program(MOLD_PATH mold)",
      "    ",
      "    if(MOLD_PATH)",
      "        message(STATUS \"Found mold linker: \\${MOLD_PATH}\")",
      "        # Tell the compiler to use the mold linker",
      "        add_link_options(\"-fuse-ld=mold\")",
      "    else()",
      "        message(STATUS \"mold linker not found, using system default linker\")",
      "    endif()",
      "endif()"
    ],
    "description": "Use mold linker for faster linking on Linux/macOS"
  }
}
