/* swaync style — Material 3 / matugen (colors inlined) */

* {
  font-family: "JetBrains Mono NF", "Inter", sans-serif;
  font-size: 13px;
  background-clip: border-box;
}

/* ---------- Control Center ---------- */
.control-center {
  background: {{colors.surface.default.hex}};
  border: 1px solid {{colors.outline_variant.default.hex}};
  border-radius: 16px;
  padding: 12px;
  margin: 10px;
  color: {{colors.on_surface.default.hex}};
}

.control-center-list {
  background: transparent;
}

.control-center-list-placeholder {
  color: {{colors.on_surface_variant.default.hex}};
  opacity: 0.6;
}

trough {
  background: {{colors.surface_container_low.default.hex}};
  border-radius: 8px;
}

slider {
  background: {{colors.primary.default.hex}};
  border-radius: 8px;
  min-width: 6px;
}

/* ---------- Title bar (clear all) ---------- */
.widget-title {
  color: {{colors.on_surface.default.hex}};
  margin: 4px 8px 12px 8px;
  font-size: 15px;
  font-weight: 600;
}

.widget-title > button,
.widget-title button {
  all: unset;
  background-color: {{colors.primary_container.default.hex}};
  background-image: none;
  color: {{colors.on_primary_container.default.hex}};
  border-radius: 12px;
  padding: 6px 14px;
  margin-left: 8px;
  transition: background-color 0.15s ease;
}
.widget-title > button label,
.widget-title button label {
  color: {{colors.on_primary_container.default.hex}};
}
.widget-title > button:hover,
.widget-title button:hover {
  background-color: {{colors.primary.default.hex}};
  color: {{colors.on_primary.default.hex}};
}
.widget-title > button:hover label,
.widget-title button:hover label {
  color: {{colors.on_primary.default.hex}};
}

/* ---------- DND switch ---------- */
.widget-dnd {
  color: {{colors.on_surface.default.hex}};
  margin: 4px 8px;
  font-size: 13px;
}
.widget-dnd > switch {
  background: {{colors.surface_container_high.default.hex}};
  border-radius: 999px;
  border: 1px solid {{colors.outline_variant.default.hex}};
  margin-left: 8px;
}
.widget-dnd > switch:checked {
  background: {{colors.primary.default.hex}};
}
.widget-dnd > switch slider {
  background: {{colors.on_surface_variant.default.hex}};
  border-radius: 999px;
  min-width: 18px;
  min-height: 18px;
}
.widget-dnd > switch:checked slider {
  background: {{colors.on_primary.default.hex}};
}

/* ---------- Notification card ---------- */
.notification-row {
  background: transparent;
  padding: 0;
}

.notification-background .notification,
.notification {
  background: {{colors.surface_container.default.hex}};
  border: 1px solid {{colors.outline_variant.default.hex}};
  border-radius: 14px;
  margin: 6px 4px;
  padding: 0;
  color: {{colors.on_surface.default.hex}};
}

.notification-content {
  padding: 12px 14px;
  background: transparent;
}

.summary {
  font-size: 14px;
  font-weight: 600;
  color: {{colors.on_surface.default.hex}};
}

.time {
  font-size: 12px;
  color: {{colors.on_surface_variant.default.hex}};
  margin-left: 8px;
}

.body {
  font-size: 13px;
  color: {{colors.on_surface_variant.default.hex}};
  margin-top: 4px;
}

.app-name {
  font-size: 11px;
  color: {{colors.secondary.default.hex}};
  font-weight: 500;
}

/* close button */
.close-button {
  background: transparent;
  color: {{colors.on_surface_variant.default.hex}};
  border: none;
  border-radius: 999px;
  margin: 6px;
  padding: 4px 8px;
  transition: background 0.15s ease, color 0.15s ease;
}
.close-button:hover {
  background: {{colors.error.default.hex}};
  color: {{colors.on_error.default.hex}};
}

/* notification action buttons (e.g. notify-send --action) */
.notification-default-action {
  background: transparent;
  color: {{colors.on_surface.default.hex}};
  border: none;
  padding: 4px;
}
.notification-action,
.notification-row .notification-background .notification .notification-action {
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
}
.notification-action > button,
.notification-row .notification-background .notification .notification-action > button {
  all: unset;
  background-color: {{colors.surface_container_high.default.hex}};
  background-image: none;
  color: {{colors.on_surface.default.hex}};
  border-radius: 10px;
  margin: 4px 4px 8px 4px;
  padding: 6px 12px;
  transition: background-color 0.15s ease;
}
.notification-action > button label {
  color: {{colors.on_surface.default.hex}};
}
.notification-action > button:hover {
  background-color: {{colors.primary_container.default.hex}};
  color: {{colors.on_primary_container.default.hex}};
}
.notification-action > button:hover label {
  color: {{colors.on_primary_container.default.hex}};
}

/* critical urgency */
.notification.critical,
.notification.critical .notification-content {
  border-color: {{colors.error.default.hex}};
}

/* ---------- Floating popups ---------- */
.floating-notifications.background .notification {
  background: {{colors.surface_container.default.hex}};
  border: 1px solid {{colors.outline_variant.default.hex}};
  border-radius: 14px;
  margin: 8px;
}

/* ---------- Inline reply ---------- */
entry {
  background: {{colors.surface_container_high.default.hex}};
  color: {{colors.on_surface.default.hex}};
  border: 1px solid {{colors.outline_variant.default.hex}};
  border-radius: 10px;
  padding: 6px 10px;
}
entry:focus {
  border-color: {{colors.primary.default.hex}};
}

/* ---------- Image ---------- */
.image {
  border-radius: 8px;
}
