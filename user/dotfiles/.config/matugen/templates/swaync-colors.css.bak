@define-color m3_surface_c_high   {{colors.surface_container_high.default.hex}};
@define-color m3_surface_c_highest {{colors.surface_container_highest.default.hex}};
@define-color m3_on_surface       {{colors.on_surface.default.hex}};
@define-color m3_on_surface_var   {{colors.on_surface_variant.default.hex}};
@define-color m3_outline          {{colors.outline.default.hex}};
@define-color m3_outline_variant  {{colors.outline_variant.default.hex}};
@define-color m3_primary          {{colors.primary.default.hex}};
@define-color m3_on_primary       {{colors.on_primary.default.hex}};
@define-color m3_primary_container {{colors.primary_container.default.hex}};
@define-color m3_on_primary_container {{colors.on_primary_container.default.hex}};
@define-color m3_secondary        {{colors.secondary.default.hex}};
@define-color m3_tertiary         {{colors.tertiary.default.hex}};
@define-color m3_error            {{colors.error.default.hex}};
