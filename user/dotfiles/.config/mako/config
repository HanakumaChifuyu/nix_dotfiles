# ── mako 通知配置 ─────────────────────────────────────────────────────────

# ---- 全局行为 ----
max-history=10
sort=-time

# ---- 交互 ----
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action

# ---- 字体 ----
font=JetBrains Mono 11

# ---- 外观（颜色由 matugen 生成） ----
border-size=2
border-radius=10

# ---- 布局 ----
# height 是最大高度；设得太低会让长正文被裁剪。
width=520
height=600
outer-margin=10
margin=6
padding=14
icons=1
max-icon-size=40
icon-location=left
# icon-theme=Papirus-Dark

# ---- 格式 ----
markup=1
actions=1
history=1
format=<b>%s</b>\n%b
text-alignment=left

# ---- 超时 ----
default-timeout=8000
ignore-timeout=0

# ---- 显示 ----
max-visible=5
layer=overlay
anchor=top-right

# 必须位于全局段；matugen 模板内的 urgency/app-name 段会在下方的
# 同名段之前定义颜色，而下方仅补充行为与布局。
include=~/.cache/matugen/mako-colors

# ── 按紧急级别覆盖样式 ────────────────────────────────────────────────────

[urgency=low]
default-timeout=5000

[urgency=normal]
default-timeout=5000

[urgency=high]
default-timeout=12000

# ── 专门为 Hyprland 工作区切换设置的样式 ──────────────────────────────────────

[app-name=hyprland]
anchor=top-left
font=JetBrains Mono Bold 24
text-alignment=center
width=260
height=100
padding=25
border-radius=20
border-size=4
format=<b>%s</b>
